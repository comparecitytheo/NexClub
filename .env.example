# --- Database (managed Postgres: Neon / Supabase / RDS) ---
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/valet_crm?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection used by `prisma migrate`. Same value is fine
# for a plain Postgres instance without a pooler.
DIRECT_URL="postgresql://user:password@host:5432/valet_crm?sslmode=require"

# --- Auth.js v5 ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Public base URL of the app.
AUTH_URL="http://localhost:3000"

# New members joining via self-registration are attached to this club org.
DEFAULT_ORG_SLUG="nexlink"
DEFAULT_ORG_NAME="NexLink"

# --- AWS S3 / S3-compatible storage (avatars, attachments) ---
S3_REGION="ap-southeast-2"
S3_BUCKET="valet-crm-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint for R2 / MinIO. Leave blank for AWS.
S3_ENDPOINT=""

# --- Claude API (AI features, Phase 6) ---
ANTHROPIC_API_KEY=""
# Optional: override the model used for AI features (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=""

# --- Email (password-reset + notification emails, Phase 2/7) ---
EMAIL_FROM="NexLink <no-reply@nexlink.app>"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Scheduled jobs. REQUIRED — without it /api/cron/* refuse to run, and task
# reminders, RSVP reminders and the monthly Lost->Deleted sweep all stay
# inactive. The endpoints are public URLs; this secret is what stops anyone
# triggering them. Vercel sends it automatically once set in project settings.
CRON_SECRET=

# --- Optional overrides (read in code, previously undocumented) ---
# How long an invitation link stays valid. Default 7.
INVITATION_TTL_DAYS="7"
# Retention window for `npm run purge` (deletes audit/archive rows older than
# this). Default 365. Purge refuses to run on a non-positive value.
RETENTION_DAYS="365"
# Display name for the first account created by `npm run bootstrap`.
# Default "Club Owner". Only read by that script.
BOOTSTRAP_NAME="Club Owner"
# Guard on `npm run db:seed`. The seed refuses to wipe data unless this is set.
# Leave UNSET in every deployed environment.
ALLOW_DESTRUCTIVE_SEED=""
